class node:
    def __init__(self, data):
        self.data = data
        self.next = None


def sort(head):
    if not head:
        return

    swapped = True
    while swapped:
        swapped = False
        current = head

        while current.next:
            if current.data > current.next.data:
                current.data, current.next.data = current.next.data, current.data
                swapped = True
            current = current.next


def traverse(head):
    current = head
    while current:
        print(current.data, end=", ")
        current = current.next


node1 = node(7)
node2 = node(4)
node3 = node(11)
node4 = node(2)
node5 = node(4)

node1.next = node2
node2.next = node3
node3.next = node4
node4.next = node5

sort(node1)
traverse(node1)
